# Database Configuration
# For local development:
DATABASE_URL=postgresql://username:password@localhost:5432/eon_db

# For Coolify deployment (replace with your actual values):
# DATABASE_URL=postgresql://eon_user:your_password@postgres:5432/eon_db
# Note: 'postgres' is the service name in Coolify's internal network

# Application Configuration
NODE_ENV=development
PORT=3000

# Next.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# Coolify-specific settings
# SSL is disabled for Coolify PostgreSQL compatibility
SSL_MODE=disable
POOL_SIZE=10
